#!/usr/bin/env python3
"""Size discipline for one repo, configured by the "size" block of factory.json.

Run from the repo root:
  check-size [check]          file budget + ratchet, base64 and huge literals, unit ledger;
                              the ratchet and ledger may not loosen against the default branch
  check-size baseline --init  record today's over-limit files once, at adoption
  check-size baseline         rewrite the ratchet baseline; entries may only shrink or go
  check-size record RELEASE   record the unit ledger at a release
  check-size netloc RANGE     net lines (added minus deleted) for a git range, e.g. main...HEAD
Exit 0 is green, 1 is red, 2 is a usage or config error.
"""
import datetime
import fnmatch
import json
import os
import re
import subprocess
import sys

GENERATED = re.compile(r"Code generated .* DO NOT EDIT")  # "// Code generated by protoc. DO NOT EDIT."
RUST_LITERAL = re.compile(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])\'|//.*')  # strings, chars, // comments
RUST_TEST_MOD = re.compile(r"\s*(pub\s+)?mod\s+\w+\s*\{")
# ponytail: a line of 16+ base64 chars alone; a 20-line run of short words could trip it.
BASE64_LINE = re.compile(r"\s*[A-Za-z0-9+/_-]{16,}={0,2}\s*")
BASE64_RUN = 20
EXEMPT_DAYS = 120


def die(msg, code=2):
    print(f"check-size: {msg}", file=sys.stderr)
    sys.exit(code)


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")


def listed_files():
    try:
        out = subprocess.run(["git", "ls-files", "-z", "-co", "--exclude-standard"],
                             capture_output=True, check=True).stdout
        return [os.fsdecode(p) for p in out.split(b"\0") if p]
    except (OSError, subprocess.CalledProcessError):  # not a git repo: walk the tree
        paths = []
        for d, dirs, files in os.walk("."):
            dirs[:] = [x for x in dirs if x != ".git"]
            paths += [os.path.relpath(os.path.join(d, f)) for f in files]
        return paths


def committed(cfg, path):
    """path as committed on the default branch (local, else origin), or None before adoption."""
    for ref in (cfg["branch"], f"origin/{cfg['branch']}"):
        try:
            r = subprocess.run(["git", "show", f"{ref}:{path}"], capture_output=True)
        except OSError:
            return None
        if r.returncode == 0:
            try:
                return json.loads(r.stdout)
            except ValueError:
                die(f"{ref}:{path} is not valid JSON", 1)
    return None


def matches(path, globs):
    return any(fnmatch.fnmatch(path, g) for g in globs)


def sources(cfg):
    """(path, text) for every source file the budget covers. Binary files are skipped."""
    out = []
    for p in sorted(listed_files()):
        if not os.path.isfile(p) or not matches(p, cfg["include"]) or matches(p, cfg.get("exclude", [])):
            continue
        with open(p, "rb") as f:
            raw = f.read()
        if b"\0" not in raw:
            out.append((p, raw.decode("utf-8", "replace")))
    return out


def generated(cfg, base, path, text):
    """Exempt only a path in size.generated, not in the baseline, with the marker in its first 5 lines."""
    return (matches(path, cfg.get("generated", [])) and path not in base
            and any(GENERATED.search(line) for line in text.splitlines()[:5]))


def loc(path, text):
    lines = text.splitlines()
    if not path.endswith(".rs"):
        return len(lines)
    # Rust: inline #[cfg(test)] modules do not count.
    # ponytail: braces are counted per line after stripping strings, chars and // comments; block
    # comments and multi-line or raw strings can still unbalance it, which only ever counts lines in.
    n, i = 0, 0
    while i < len(lines):
        if lines[i].strip() == "#[cfg(test)]" and i + 1 < len(lines) and RUST_TEST_MOD.match(lines[i + 1]):
            depth, start, i = 0, i, i + 1
            while i < len(lines):
                code = RUST_LITERAL.sub("", lines[i])
                depth += code.count("{") - code.count("}")
                i += 1
                if depth <= 0:
                    break
            if depth > 0:  # never closed: the skip was wrong, count every line back in
                n += i - start
            continue
        n += 1
        i += 1
    return n


def check_files(cfg, files):
    warn, hard = cfg["warn_lines"], cfg["max_lines"]
    base = load_json(cfg["baseline"], {})
    blob = re.compile(r"[A-Za-z0-9+/_-]{%d,}={0,2}" % cfg["base64_min_chars"])
    red = []
    main = committed(cfg, cfg["baseline"]) or {}
    for path, cap in sorted(base.items()):
        if main and path not in main:
            red.append(f"{path}: new in the baseline since {cfg['branch']}; the baseline may only shrink")
        elif main and cap > main[path]:
            red.append(f"{path}: baseline cap raised {main[path]} -> {cap} since {cfg['branch']}")
    for path, text in files:
        if generated(cfg, base, path, text):
            continue
        n, cap = loc(path, text), base.get(path)
        if cap is not None and n > cap:
            red.append(f"{path}: {n} lines, baseline {cap}; a file over the limit may only shrink")
        elif cap is None and n > hard:
            red.append(f"{path}: {n} lines, over the {hard}-line hard limit")
        elif n > warn:
            print(f"warn {path}: {n} lines, over the {warn}-line aim")
        run = 0
        for i, line in enumerate(text.splitlines(), 1):
            run = run + 1 if BASE64_LINE.fullmatch(line) else 0
            if run == BASE64_RUN:
                red.append(f"{path}:{i - run + 1}: {run}+ lines of base64; move data out of source")
            if blob.search(line):
                red.append(f"{path}:{i}: embedded base64-like blob; move data out of source")
            elif len(line) > cfg["max_line_chars"]:
                red.append(f"{path}:{i}: {len(line)}-char line; move large literals out of source")
    return red


def measure(cfg, files):
    units = {}
    for name, globs in cfg["units"].items():
        hit = [(p, t) for p, t in files if matches(p, globs)]
        units[name] = {"bytes": sum(len(t.encode()) for _, t in hit),
                       "loc": sum(loc(p, t) for p, t in hit), "files": len(hit)}
    return units


def check_ledger(cfg, files):
    old = load_json(cfg["ledger"], None)
    if old is None:
        return [f"no ledger at {cfg['ledger']}; record one with 'check-size record <release>'"]
    pct, today = cfg["unit_growth_pct"], datetime.date.today()
    main = (committed(cfg, cfg["ledger"]) or {}).get("units", {})
    red = [f"unit {n}: in the ledger but not in size.units; re-record or fix factory.json"
           for n in sorted(set(old["units"]) - set(cfg["units"]))]
    red += [f"{p}: in no size.units unit" for p, _ in files if not any(matches(p, g) for g in cfg["units"].values())]
    exempt = {}
    for e in cfg.get("exemptions", []):
        try:
            until = datetime.date.fromisoformat(e["until"])
        except (KeyError, TypeError, ValueError):
            red.append(f"exemption {e!r}: 'until' must be a YYYY-MM-DD date")
            continue
        if until > today + datetime.timedelta(days=EXEMPT_DAYS):
            red.append(f"exemption for unit {e.get('unit')}: until {until} is over {EXEMPT_DAYS} days out")
        else:
            exempt[e.get("unit")] = (until, e.get("reason", "no reason given"))
    for name, cur in measure(cfg, files).items():
        if cur["files"] == 0:
            red.append(f"unit {name}: its globs match no files; fix factory.json")
            continue
        base = old["units"].get(name)
        if base is None:
            red.append(f"unit {name}: not in the ledger of release {old['release']}; re-record it")
            continue
        for key in ("bytes", "loc"):
            # The ledger may be re-recorded on a branch; growth also counts from the default branch's copy.
            was = min(base[key], main.get(name, base)[key])
            if cur[key] <= was * (1 + pct / 100):
                continue
            growth = f"unit {name}: {key} {was} -> {cur[key]}, over {pct}% since release {old['release']}"
            until, reason = exempt.get(name, (None, None))
            if until and until >= today:
                print(f"exempt {growth} (until {until}: {reason})")
            else:
                red.append(growth + (f"; exemption expired {until}" if until else "; needs an exemption with an expiry"))
    return red


def baseline(cfg, files, init):
    old = load_json(cfg["baseline"], None)
    if init and old is not None:
        die("a baseline exists; --init is a one-time adoption step")
    if not init and old is None:
        die("no baseline; run 'check-size baseline --init' once at adoption")
    base = old or {}
    over = {p: n for p, t in files if not generated(cfg, base, p, t) and (n := loc(p, t)) > cfg["max_lines"]}
    new = over if init else {p: min(n, old[p]) for p, n in over.items() if p in old}
    write_json(cfg["baseline"], new)
    print(f"baseline: {len(new)} file(s) over {cfg['max_lines']} lines, each capped at its size")


def netloc(cfg, rng):
    out = subprocess.run(["git", "diff", "--numstat", "-z", "--no-renames", rng], capture_output=True)
    if out.returncode:
        die(os.fsdecode(out.stderr).strip())
    rows = []
    for rec in out.stdout.split(b"\0"):
        if not rec:
            continue
        a, d, p = os.fsdecode(rec).split("\t", 2)
        if a != "-" and matches(p, cfg["include"]) and not matches(p, cfg.get("exclude", [])):
            rows.append((int(a) - int(d), int(a), int(d), p))
    for net, _, _, p in sorted(rows, reverse=True)[:10]:
        print(f"{net:+6d} {p}")
    added, deleted = sum(r[1] for r in rows), sum(r[2] for r in rows)
    print(f"net {added - deleted:+d} lines (added {added}, deleted {deleted}) across {len(rows)} source file(s) in {rng}")


def main(argv):
    cfg = load_json("factory.json", None)
    if cfg is None or "size" not in cfg:
        die("run from the repo root; factory.json with a 'size' block is required")
    cfg = dict(cfg["size"], branch=cfg.get("default_branch", "main"))
    cmd = argv[0] if argv else "check"
    if cmd == "netloc" and len(argv) == 2:
        return netloc(cfg, argv[1])
    files = sources(cfg)
    if cmd == "check" and len(argv) <= 1:
        red = check_files(cfg, files) + check_ledger(cfg, files)
        for r in red:
            print(f"RED {r}")
        print(f"size: {'red' if red else 'ok'} ({len(files)} source files)")
        sys.exit(1 if red else 0)
    if cmd == "baseline" and argv[1:] in ([], ["--init"]):
        return baseline(cfg, files, argv[1:] == ["--init"])
    if cmd == "record" and len(argv) == 2:
        write_json(cfg["ledger"], {"release": argv[1], "units": measure(cfg, files)})
        return print(f"ledger recorded for release {argv[1]}")
    die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
