{
  "name": "plainview",
  "version": "0.0.0",
  "private": true,
  "description": "Local document-to-Markdown converter with built-in hidden-content flagging",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "plainview": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./hidden": {
      "types": "./dist/hidden.d.ts",
      "import": "./dist/hidden.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts test/injection/*.test.ts",
    "check": "tsc --noEmit && biome check && node scripts/check-size.ts",
    "golden": "node scripts/make-golden.ts",
    "smoke": "node scripts/smoke.mjs",
    "licences": "node scripts/check-licences.ts",
    "size": "node scripts/check-size.ts",
    "net-loc": "node scripts/net-loc.ts"
  }
}
