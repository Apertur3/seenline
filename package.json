{
  "name": "seenline",
  "mcpName": "io.github.Apertur3/seenline",
  "version": "0.1.0",
  "description": "Local document-to-Markdown converter with built-in hidden-content flagging",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apertur3/seenline.git"
  },
  "homepage": "https://github.com/Apertur3/seenline#readme",
  "bugs": {
    "url": "https://github.com/Apertur3/seenline/issues"
  },
  "keywords": [
    "document",
    "markdown",
    "pdf",
    "docx",
    "mcp",
    "prompt-injection",
    "hidden-text",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "js-tiktoken": "1.0.21",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seenline": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./hidden": {
      "types": "./dist/hidden.d.ts",
      "import": "./dist/hidden.js"
    }
  },
  "files": [
    "dist",
    "docs/DEPENDENCIES.md",
    "docs/TESTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts test/injection/*.test.ts bench/*.test.ts",
    "check": "npm run types && npm run lint",
    "golden": "node scripts/make-golden.ts",
    "smoke": "node scripts/smoke.mjs",
    "licences": "node scripts/check-licences.ts",
    "lint": "biome check",
    "types": "tsc --noEmit",
    "golden-check": "node --test test/golden.test.ts",
    "acceptance": "npm run build && npm run smoke && node --test test/cli.test.ts test/mcp.test.ts",
    "pack-smoke": "sh scripts/pack-smoke.sh",
    "bench": "node bench/run.ts"
  }
}
